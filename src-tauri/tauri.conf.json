{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracker",
  "version": "0.1.0",
  "identifier": "com.sistem.tracker",

  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/tracker/browser"
  },

  "app": {
    "windows": [
      {
        "title": "tracker",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
